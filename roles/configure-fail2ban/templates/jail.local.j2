[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5

# SSH is already restricted to the provisioning machine's IP by UFW;
# this is just a failsafe in case the firewall ever opens up.
[sshd]
enabled = true
backend = systemd

# The VPS firewall never sees visitor IPs behind Cloudflare's proxy, so
# bans are pushed to Cloudflare's edge as zone-level IP access rules.
# bantime -1 = permanent; unban via CF dashboard (Security -> Security
# rules -> IP access rules) or: fail2ban-client set wordpress unbanip <ip>
[wordpress]
enabled = true
filter  = wordpress
logpath = /var/log/nginx/access.log
bantime = -1
action  = cloudflare-token[cftoken="{{ cloudflare_api_token }}", cfzone="{{ cloudflare_zone_id }}"]
